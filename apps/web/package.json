{
  "name": "@turbo-ai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:fullstack": "playwright test -c playwright.fullstack.config.ts",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/shared/api/generated/schema.ts --alphabetize",
    "check:api": "openapi-typescript ../api/openapi.yaml -o src/shared/api/generated/schema.ts --alphabetize --check",
    "check": "pnpm format:check && pnpm check:api && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "check:ci": "pnpm check && pnpm test:e2e && pnpm test:fullstack"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "next": "16.3.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
